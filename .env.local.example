# ─── COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES ─────────────────────
# cp .env.local.example .env.local

# ─── SMTP EMAIL SETTINGS ──────────────────────────────────────────────────────

# OPTION 1 — Gmail (recommended for quick setup)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: Google Account → Security → App Passwords
# 3. Generate a password for "Mail" and paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password-here

# OPTION 2 — Outlook / Office 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@outlook.com
# SMTP_PASS=your-password

# OPTION 3 — Custom SMTP (Zoho, GoDaddy, etc.)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@zoho.com
# SMTP_PASS=your-password

# ─── INQUIRY DESTINATION ──────────────────────────────────────────────────────
# Where inquiry emails get delivered (defaults to SMTP_USER if not set)
CONTACT_EMAIL=exports@eastcoastcompany.com

# ─── ADMIN DASHBOARD ──────────────────────────────────────────────────────────
# Password to access /admin — change this to something secure
ADMIN_KEY=eastcoast2024
